# Portuguese (Brazil) translation for Joplin Plugin Hotfolder i18n
msgid ""
msgstr ""
"Project-Id-Version: joplin-plugin-hotfolder-i18n\n"
"Language: pt_BR\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Plural-Forms: nplurals=2; plural=(n > 1);\n"

msgid "Hotfolder i18n"
msgstr "Hotfolder i18n"

msgid "Hotfolder Path"
msgstr "Caminho da pasta monitorada"

msgid "Folder from which the files should be imported"
msgstr "Pasta da qual os arquivos devem ser importados"

msgid "Ignore Files"
msgstr "Ignorar arquivos"

msgid "Comma separated list of files which will be ignored"
msgstr "Lista de arquivos a serem ignorados, separados por vírgula"

msgid "Add as text"
msgstr "Adicionar como texto"

msgid "Comma separated list of file extensions, which will be imported as text"
msgstr "Lista de extensões de arquivo que serão importadas como texto, separadas por vírgula"

msgid "Add text notes as Todo"
msgstr "Adicionar notas de texto como tarefas"

msgid "Text only notes will be imported as Todo type notes, all other file types will be imported as attachments in regular notes"
msgstr "Notas somente de texto serão importadas como tarefas; todos os outros tipos de arquivo serão importados como anexos em notas normais"

msgid "Notebook"
msgstr "Caderno"

msgid "If no notebook is specified, the import is made to the current notebook. Subnotebooks can be defined via Project\\Scans"
msgstr "Se nenhum caderno for especificado, a importação será feita no caderno atual. Subcadernos podem ser definidos no formato Project\\Scans"

msgid "Tags"
msgstr "Etiquetas"

msgid "Comma separated list of tags to be added to the note"
msgstr "Lista de etiquetas a serem adicionadas à nota, separadas por vírgula"

msgid "File ready"
msgstr "Arquivo pronto"

msgid "Every how many seconds should be checked whether the file in the hotfolder is ready (Checks the file size and file lock additionally)"
msgstr "A cada quantos segundos verificar se o arquivo na pasta monitorada está pronto (verifica também o tamanho e o bloqueio do arquivo)"

msgid "Polling"
msgstr "Sondagem"

msgid "May be necessary for Hotfolders in the network. Leads to a slightly higher system load"
msgstr "Pode ser necessário para pastas monitoradas na rede. Causa uma carga do sistema um pouco maior"

msgid "Polling intervall"
msgstr "Intervalo de sondagem"

msgid "Interval in milliseconds for querying the hotfolder"
msgstr "Intervalo em milissegundos para consultar a pasta monitorada"

msgid "Depth"
msgstr "Profundidade"

msgid "How many subdirectories will be checked for file import"
msgstr "Quantos níveis de subpastas serão verificados para a importação de arquivos"

msgid "Number of Hotfolders"
msgstr "Número de pastas monitoradas"

msgid "Additional Hotfolder Sections appear on the left (Please restart Joplin after a change)"
msgstr "Seções adicionais de pastas monitoradas aparecem à esquerda (reinicie o Joplin após uma alteração)"

msgid "Loglevel"
msgstr "Nível de log"

#, c-format
msgid "Log level for the log file %s"
msgstr "Nível de log para o arquivo de log %s"

msgid "Off"
msgstr "Desligado"

msgid "Verbose"
msgstr "Detalhado"

msgid "Info"
msgstr "Informação"

msgid "Warning"
msgstr "Aviso"

msgid "Error"
msgstr "Erro"

#, c-format
msgid "Notebook `%s` for import destination of Hotfolder %s doesn't exist use actual notebook for imports"
msgstr "O caderno `%s` definido como destino de importação da pasta monitorada %s não existe; o caderno atual será usado para as importações"
