# Spanish translation for Joplin Plugin Hotfolder i18n
msgid ""
msgstr ""
"Project-Id-Version: joplin-plugin-hotfolder-i18n\n"
"Language: es_ES\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Plural-Forms: nplurals=2; plural=(n != 1);\n"

msgid "Hotfolder i18n"
msgstr "Hotfolder i18n"

msgid "Hotfolder Path"
msgstr "Ruta de la carpeta supervisada"

msgid "Folder from which the files should be imported"
msgstr "Carpeta desde la que se deben importar los archivos"

msgid "Ignore Files"
msgstr "Ignorar archivos"

msgid "Comma separated list of files which will be ignored"
msgstr "Lista de archivos que se ignorarán, separados por comas"

msgid "Add as text"
msgstr "Añadir como texto"

msgid "Comma separated list of file extensions, which will be imported as text"
msgstr "Lista de extensiones de archivo que se importarán como texto, separadas por comas"

msgid "Add text notes as Todo"
msgstr "Añadir notas de texto como tareas"

msgid "Text only notes will be imported as Todo type notes, all other file types will be imported as attachments in regular notes"
msgstr "Las notas de solo texto se importarán como tareas; todos los demás tipos de archivo se importarán como adjuntos en notas normales"

msgid "Notebook"
msgstr "Libreta"

msgid "If no notebook is specified, the import is made to the current notebook. Subnotebooks can be defined via Project\\Scans"
msgstr "Si no se especifica ninguna libreta, la importación se realiza en la libreta actual. Las sublibretas se pueden definir con el formato Project\\Scans"

msgid "Tags"
msgstr "Etiquetas"

msgid "Comma separated list of tags to be added to the note"
msgstr "Lista de etiquetas que se añadirán a la nota, separadas por comas"

msgid "File ready"
msgstr "Archivo listo"

msgid "Every how many seconds should be checked whether the file in the hotfolder is ready (Checks the file size and file lock additionally)"
msgstr "Cada cuántos segundos se comprueba si el archivo de la carpeta supervisada está listo (también comprueba el tamaño y el bloqueo del archivo)"

msgid "Polling"
msgstr "Sondeo"

msgid "May be necessary for Hotfolders in the network. Leads to a slightly higher system load"
msgstr "Puede ser necesario para carpetas supervisadas en la red. Provoca una carga del sistema ligeramente mayor"

msgid "Polling intervall"
msgstr "Intervalo de sondeo"

msgid "Interval in milliseconds for querying the hotfolder"
msgstr "Intervalo en milisegundos para consultar la carpeta supervisada"

msgid "Depth"
msgstr "Profundidad"

msgid "How many subdirectories will be checked for file import"
msgstr "Cuántos niveles de subcarpetas se comprobarán para importar archivos"

msgid "Number of Hotfolders"
msgstr "Número de carpetas supervisadas"

msgid "Additional Hotfolder Sections appear on the left (Please restart Joplin after a change)"
msgstr "Las secciones de carpetas supervisadas adicionales aparecen a la izquierda (reinicie Joplin después de un cambio)"

msgid "Loglevel"
msgstr "Nivel de registro"

#, c-format
msgid "Log level for the log file %s"
msgstr "Nivel de registro para el archivo de registro %s"

msgid "Off"
msgstr "Desactivado"

msgid "Verbose"
msgstr "Detallado"

msgid "Info"
msgstr "Información"

msgid "Warning"
msgstr "Advertencia"

msgid "Error"
msgstr "Error"

#, c-format
msgid "Notebook `%s` for import destination of Hotfolder %s doesn't exist use actual notebook for imports"
msgstr "La libreta `%s` configurada como destino de importación de la carpeta supervisada %s no existe; se usará la libreta actual para las importaciones"
