# Russian translation for Joplin Plugin Hotfolder i18n
msgid ""
msgstr ""
"Project-Id-Version: joplin-plugin-hotfolder-i18n\n"
"Language: ru_RU\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Plural-Forms: nplurals=3; plural=(n%10==1 && n%100!=11 ? 0 : n%10>=2 && n%10<=4 && (n%100<10 || n%100>=20) ? 1 : 2);\n"

msgid "Hotfolder i18n"
msgstr "Hotfolder i18n"

msgid "Hotfolder Path"
msgstr "Путь к отслеживаемой папке"

msgid "Folder from which the files should be imported"
msgstr "Папка, из которой нужно импортировать файлы"

msgid "Ignore Files"
msgstr "Игнорируемые файлы"

msgid "Comma separated list of files which will be ignored"
msgstr "Список игнорируемых файлов через запятую"

msgid "Add as text"
msgstr "Добавлять как текст"

msgid "Comma separated list of file extensions, which will be imported as text"
msgstr "Список расширений файлов через запятую, которые будут импортированы как текст"

msgid "Add text notes as Todo"
msgstr "Добавлять текстовые заметки как задачи"

msgid "Text only notes will be imported as Todo type notes, all other file types will be imported as attachments in regular notes"
msgstr "Текстовые заметки будут импортированы как задачи, все остальные типы файлов — как вложения в обычные заметки"

msgid "Notebook"
msgstr "Блокнот"

msgid "If no notebook is specified, the import is made to the current notebook. Subnotebooks can be defined via Project\\Scans"
msgstr "Если блокнот не указан, импорт выполняется в текущий блокнот. Вложенные блокноты можно указать в виде Project\\Scans"

msgid "Tags"
msgstr "Теги"

msgid "Comma separated list of tags to be added to the note"
msgstr "Список тегов через запятую, которые будут добавлены к заметке"

msgid "File ready"
msgstr "Готовность файла"

msgid "Every how many seconds should be checked whether the file in the hotfolder is ready (Checks the file size and file lock additionally)"
msgstr "Как часто (в секундах) проверять, готов ли файл в отслеживаемой папке (дополнительно проверяются размер файла и его блокировка)"

msgid "Polling"
msgstr "Опрос"

msgid "May be necessary for Hotfolders in the network. Leads to a slightly higher system load"
msgstr "Может потребоваться для отслеживаемых папок в сети. Немного увеличивает нагрузку на систему"

msgid "Polling intervall"
msgstr "Интервал опроса"

msgid "Interval in milliseconds for querying the hotfolder"
msgstr "Интервал опроса отслеживаемой папки в миллисекундах"

msgid "Depth"
msgstr "Глубина"

msgid "How many subdirectories will be checked for file import"
msgstr "Сколько уровней вложенных папок проверять при импорте файлов"

msgid "Number of Hotfolders"
msgstr "Количество отслеживаемых папок"

msgid "Additional Hotfolder Sections appear on the left (Please restart Joplin after a change)"
msgstr "Дополнительные разделы отслеживаемых папок появятся слева (после изменения перезапустите Joplin)"

msgid "Loglevel"
msgstr "Уровень журнала"

#, c-format
msgid "Log level for the log file %s"
msgstr "Уровень журнала для файла журнала %s"

msgid "Off"
msgstr "Выкл."

msgid "Verbose"
msgstr "Подробный"

msgid "Info"
msgstr "Информация"

msgid "Warning"
msgstr "Предупреждение"

msgid "Error"
msgstr "Ошибка"

#, c-format
msgid "Notebook `%s` for import destination of Hotfolder %s doesn't exist use actual notebook for imports"
msgstr "Блокнот `%s`, указанный для импорта из отслеживаемой папки %s, не существует; используется текущий блокнот"
